Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  modernize-use-override,
  modernize-use-nullptr,
  readability-braces-around-statements
WarningsAsErrors: ''
# Project headers only; CI also passes an absolute --header-filter so .cpm/ and build/ never match.
HeaderFilterRegex: '^.*/pentagrit/src/.*'
